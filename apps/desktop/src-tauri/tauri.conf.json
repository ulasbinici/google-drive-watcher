{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Drive Watch",
  "version": "1.0.5",
  "identifier": "com.drivewatch.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Drive Watch",
        "width": 1120,
        "height": 760,
        "minWidth": 820,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "'self' ipc: http://ipc.localhost https://*.googleapis.com https://*.googleusercontent.com https://*.firebaseio.com https://*.cloudfunctions.net wss://*.firebaseio.com",
        "img-src": "'self' asset: http://asset.localhost https://*.googleusercontent.com https://*.google.com blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["drivewatch"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
